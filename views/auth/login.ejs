
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= typeof title !== "undefined" && title ? title : "Login" %> | Hybrid Ecosystem</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link href="/css/style.css" rel="stylesheet">
</head>

<body class="auth-page">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">

      <a class="navbar-brand fw-bold" href="/">
        <img
          src="/images/logo.png"
          alt="Hybrid Ecosystem"
          class="site-logo"
        >
      </a>

      <a href="/register" class="btn btn-outline-light navbar-auth-btn">
        Register
      </a>

    </div>
  </nav>


  <!-- Login Section -->
  <main class="auth-container container-fluid">

    <div class="row justify-content-center w-100">

      <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

        <div class="card auth-card login-card">

          <div class="card-body">

            <!-- Heading -->
            <div class="text-center mb-4">

              <h2 class="fw-bold">Welcome Back</h2>

              <p class="text-muted mb-0">
                Login to your member account
              </p>

            </div>


            <!-- Error Message -->
            <% if (typeof error !== "undefined" && error) { %>

              <div class="alert alert-danger" role="alert">
                <%= error %>
              </div>

            <% } %>


            <!-- Login Form -->
            <form action="/login" method="POST">

              <!-- Email -->
              <div class="mb-3">

                <label for="email" class="form-label">
                  Email Address
                </label>

                <input
                  type="email"
                  class="form-control"
                  id="email"
                  name="email"
                  placeholder="Enter your email"
                  autocomplete="email"
                  required
                >

              </div>


              <!-- Password -->
              <div class="mb-3">

                <label for="password" class="form-label">
                  Password
                </label>

                <div class="input-group password-input-group">

                  <input
                    type="password"
                    class="form-control"
                    id="password"
                    name="password"
                    placeholder="Enter your password"
                    autocomplete="current-password"
                    required
                  >

                  <button
                    class="btn btn-outline-secondary password-show-btn"
                    type="button"
                    id="togglePassword"
                    aria-label="Show password"
                    aria-pressed="false"
                  >
                    Show
                  </button>

                </div>

              </div>


              <!-- Login Button -->
              <div class="d-grid mt-4">

                <button type="submit" class="btn btn-primary btn-lg">
                  Login
                </button>

              </div>

            </form>


            <!-- Register Link -->
            <div class="text-center mt-4">

              <span class="text-muted">
                Don't have an account?
              </span>

              <a href="/register" class="fw-semibold">
                Register Now
              </a>

            </div>

          </div>

        </div>


        <!-- Copyright -->
        <p class="text-center text-muted small mt-4">
          &copy; <%= new Date().getFullYear() %> Hybrid Ecosystem
        </p>

      </div>

    </div>

  </main>


  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


  <!-- Show / Hide Password -->
  <script>
    const passwordInput = document.getElementById("password");
    const togglePassword = document.getElementById("togglePassword");

    if (passwordInput && togglePassword) {

      togglePassword.addEventListener("click", function () {

        const isPasswordHidden = passwordInput.type === "password";

        passwordInput.type = isPasswordHidden ? "text" : "password";

        this.textContent = isPasswordHidden ? "Hide" : "Show";

        this.setAttribute(
          "aria-label",
          isPasswordHidden ? "Hide password" : "Show password"
        );

        this.setAttribute(
          "aria-pressed",
          String(isPasswordHidden)
        );

      });

    }
  </script>

</body>
</html>
