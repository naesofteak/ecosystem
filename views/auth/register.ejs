
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= typeof title !== "undefined" && title ? title : "Register" %> | Hybrid Ecosystem</title>

  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">
</head>

<body class="auth-page">

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">

      <a class="navbar-brand fw-bold" href="/">
        <img
          src="/images/logo.png"
          alt="Hybrid Ecosystem"
          class="site-logo"
        >
      </a>

      <a href="/login" class="btn btn-outline-light navbar-auth-btn">
        Login
      </a>

    </div>
  </nav>

  <!-- REGISTRATION SECTION -->
  <main class="auth-container container-fluid">

    <div class="row justify-content-center w-100">

      <div class="col-12 col-md-10 col-lg-8 col-xl-7">

        <div class="card auth-card register-card">

          <div class="card-body">

            <!-- Heading -->
            <div class="text-center mb-4">

              <h2 class="fw-bold">
                Create Account
              </h2>

              <p class="text-muted mb-0">
                Join the Hybrid Ecosystem community
              </p>

            </div>

            <!-- Error Message -->
            <% if (typeof error !== "undefined" && error) { %>

              <div class="alert alert-danger" role="alert">
                <%= error %>
              </div>

            <% } %>

            <!-- REGISTRATION FORM -->
            <form action="/register" method="POST">

              <!-- Full Name -->
              <div class="mb-3">

                <label for="name" class="form-label">
                  Full Name
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="name"
                  name="name"
                  placeholder="Enter your full name"
                  autocomplete="name"
                  required
                >

              </div>

              <!-- Email and Mobile -->
              <div class="row">

                <div class="col-12 col-md-6 mb-3">

                  <label for="email" class="form-label">
                    Email Address
                  </label>

                  <input
                    type="email"
                    class="form-control"
                    id="email"
                    name="email"
                    placeholder="Enter email address"
                    autocomplete="email"
                    required
                  >

                </div>

                <div class="col-12 col-md-6 mb-3">

                  <label for="mobile" class="form-label">
                    Mobile Number
                  </label>

                  <input
                    type="tel"
                    class="form-control"
                    id="mobile"
                    name="mobile"
                    placeholder="Enter mobile number"
                    autocomplete="tel"
                    required
                  >

                </div>

              </div>

              <!-- PASSWORD WITH SHOW / HIDE -->
              <div class="mb-3">

                <label for="password" class="form-label">
                  Password
                </label>

                <div class="input-group password-input-group">

                  <input
                    type="password"
                    class="form-control"
                    id="password"
                    name="password"
                    placeholder="Minimum 8 characters"
                    minlength="8"
                    autocomplete="new-password"
                    required
                  >

                  <button
                    class="btn btn-outline-secondary password-show-btn"
                    type="button"
                    id="togglePassword"
                    aria-label="Show password"
                    aria-pressed="false"
                  >
                    Show
                  </button>

                </div>

                <div class="form-text">
                  Password must contain at least 8 characters.
                </div>

              </div>

              <!-- REFERRAL CODE -->
              <div class="mb-3">

                <label for="referralCode" class="form-label">
                  Referral Code
                  <span class="text-muted">(Optional)</span>
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="referralCode"
                  name="referralCode"
                  placeholder="Enter referral code if you have one"
                  autocomplete="off"
                >

                <div class="form-text">
                  Leave blank if you are registering without a referral.
                </div>

              </div>

              <!-- TEAM POSITION -->
              <div class="mb-3" id="placementSection" hidden>

                <label class="form-label fw-semibold">
                  Select Team Position
                  <span class="text-danger">*</span>
                </label>

                <p class="text-muted small mb-2">
                  Choose which team of your sponsor you want to join.
                </p>

                <div class="row g-3">

                  <div class="col-6">

                    <input
                      type="radio"
                      class="btn-check"
                      name="placementSide"
                      id="placementLeft"
                      value="left"
                      autocomplete="off"
                    >

                    <label
                      class="btn btn-outline-primary w-100 py-3"
                      for="placementLeft"
                    >
                      <span class="fw-bold">Left Team</span>
                    </label>

                  </div>

                  <div class="col-6">

                    <input
                      type="radio"
                      class="btn-check"
                      name="placementSide"
                      id="placementRight"
                      value="right"
                      autocomplete="off"
                    >

                    <label
                      class="btn btn-outline-primary w-100 py-3"
                      for="placementRight"
                    >
                      <span class="fw-bold">Right Team</span>
                    </label>

                  </div>

                </div>

                <div class="form-text mt-2">
                  Your account will be placed automatically in the next
                  available position within your selected team.
                </div>

              </div>

              <!-- SUBMIT BUTTON -->
              <div class="d-grid mt-4">

                <button
                  type="submit"
                  class="btn btn-primary btn-lg"
                >
                  Create Account
                </button>

              </div>

            </form>

            <!-- LOGIN LINK -->
            <div class="text-center mt-4">

              <span class="text-muted">
                Already have an account?
              </span>

              <a href="/login" class="fw-semibold">
                Login
              </a>

            </div>

          </div>

        </div>

        <!-- COPYRIGHT -->
        <p class="text-center text-muted small mt-4">
          &copy; <%= new Date().getFullYear() %> Hybrid Ecosystem
        </p>

      </div>

    </div>

  </main>

  <!-- BOOTSTRAP JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- SHOW / HIDE PASSWORD -->
  <script>
    const passwordInput = document.getElementById("password");
    const togglePassword = document.getElementById("togglePassword");

    if (passwordInput && togglePassword) {

      togglePassword.addEventListener("click", function () {

        const isPasswordHidden = passwordInput.type === "password";

        passwordInput.type = isPasswordHidden ? "text" : "password";

        this.textContent = isPasswordHidden ? "Hide" : "Show";

        this.setAttribute(
          "aria-label",
          isPasswordHidden ? "Hide password" : "Show password"
        );

        this.setAttribute(
          "aria-pressed",
          String(isPasswordHidden)
        );

      });

    }
  </script>

  <!-- REFERRAL / TEAM POSITION TOGGLE -->
  <script>
    const referralInput = document.getElementById("referralCode");
    const placementSection = document.getElementById("placementSection");

    const placementRadios = document.querySelectorAll(
      'input[name="placementSide"]'
    );

    function updatePlacementVisibility() {

      const hasReferralCode = referralInput.value.trim().length > 0;

      placementSection.hidden = !hasReferralCode;

      placementRadios.forEach(function (radio) {
        radio.required = hasReferralCode;

        if (!hasReferralCode) {
          radio.checked = false;
        }
      });

    }

    referralInput.addEventListener("input", updatePlacementVisibility);

    updatePlacementVisibility();
  </script>

</body>
</html>
